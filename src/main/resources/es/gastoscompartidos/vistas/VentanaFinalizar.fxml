<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="es.gastoscompartidos.controladores.VentanaFinalizarController">

    <VBox spacing="10" alignment="CENTER" style="-fx-padding: 16;"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <Label text="RESULTADO FINAL" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <TextArea fx:id="txtResumen"
                  prefHeight="280" wrapText="true" editable="false"
                  VBox.vgrow="ALWAYS"/>

        <Button text="CERRAR" onAction="#onClicCerrar"/>

    </VBox>
</AnchorPane>
